{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 120,
  "singleQuote": true,
  "sortImports": true,
  "sortTailwindcss": {
    // Tailwind CSS v4 は設定を CSS の @theme に書くので、エントリの CSS を渡す。@theme のトークン（bg-primary・text-title など）も並べ替えの対象になる
    "stylesheet": "./apps/web/src/styles.css",
    // 既定では className の文字だけを並べ替える。部品は class を cn と cva に渡すので、その引数の文字も並べ替える
    // 定数に入れた文字は並べ替えないので、部品の class は定数にまとめず、呼び出しの中に書く
    "functions": ["cn", "cva"]
  },
  "sortPackageJson": true,
  // wrangler types が作るファイル。整形すると wrangler types --check が「古い」と判定する
  // routeTree.gen.ts は TanStack Router のプラグインが作り直すので、整形しても戻される
  // migrations/meta は drizzle-kit がスキーマの差分をとるための写し。手で触らないので、出力のまま置く
  // CHANGELOG.md は deploy.yaml の release job が、oxfmt を動かさずに changelogen の文面を書き足す（ADR 0012）。v1.3.0 までの節は release-please が書いた形のまま残す
  // デザインのモックの HTML は、T24 までの記録として直さずに残す（docs/design/README.md）。今の styles.css にない前の名前（bg-stage など）を
  // 使うので、styles.css で並べるとその class を知らない名前とみなして並べ替えてしまう
  "ignorePatterns": [
    "**/worker-configuration.d.ts",
    "**/routeTree.gen.ts",
    "apps/api/migrations/meta/**",
    "CHANGELOG.md",
    "docs/design/mock/*.html"
  ]
}
