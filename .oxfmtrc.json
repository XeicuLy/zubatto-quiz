{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 120,
  "singleQuote": true,
  "sortImports": true,
  "sortTailwindcss": {
    "stylesheet": "./docs/design/mock/mock.css"
  },
  "sortPackageJson": true,
  // wrangler types が作るファイル。整形すると wrangler types --check が「古い」と判定する
  "ignorePatterns": ["**/worker-configuration.d.ts"]
}
