{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 120,
  "singleQuote": true,
  "sortImports": true,
  "sortTailwindcss": {
    // Tailwind CSS v4 は設定を CSS の @theme に書くので、エントリの CSS を渡す。@theme のトークン（bg-stage など）も並べ替えの対象になる
    "stylesheet": "./apps/web/src/styles.css"
  },
  "sortPackageJson": true,
  // wrangler types が作るファイル。整形すると wrangler types --check が「古い」と判定する
  // routeTree.gen.ts は TanStack Router のプラグインが作り直すので、整形しても戻される
  // migrations/meta は drizzle-kit がスキーマの差分をとるための写し。手で触らないので、出力のまま置く
  "ignorePatterns": ["**/worker-configuration.d.ts", "**/routeTree.gen.ts", "apps/api/migrations/meta/**"]
}
