    "@commitlint/config-conventional": "^21.2.3",
    "@commitlint/types": "^21.2.3",
    "@tailwindcss/cli": "4.3.3",
    "@types/node": "^24.13.6",
    "consola": "^3.4.2",
    "husky": "^9.1.7",
    "oxfmt": "^0.68.0",
    "tailwindcss": "4.3.3",
    "typescript": "^6.0.3"
  }
}
