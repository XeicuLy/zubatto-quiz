{
  "name": "zubatto-quiz",
  "version": "1.3.0",
  "private": true,
  "type": "module",
  "scripts": {
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "tsc": "tsc --noEmit && pnpm -r --if-present run tsc",
    "prepare": "husky",
    "mock:build": "tailwindcss -i docs/design/mock/mock.css -o docs/design/mock/dist/mock.css",
    "mock:watch": "tailwindcss -i docs/design/mock/mock.css -o docs/design/mock/dist/mock.css --watch",
    "lint": "oxlint --deny-warnings && shellcheck .github/scripts/*.sh",
    "test": "vitest run",
    "e2e": "playwright test",
    "guide:shots": "playwright test --config e2e/guide-screenshots/playwright.config.ts",
    "db:migrate:remote": "pnpm --filter @zubatto-quiz/api run db:migrate:remote",
    "deploy:api": "pnpm --filter @zubatto-quiz/api run deploy",
    "deploy:web": "pnpm --filter @zubatto-quiz/web run deploy",
    "logs:api": "pnpm --silent --filter @zubatto-quiz/api run logs",
    "logs:web": "pnpm --silent --filter @zubatto-quiz/web run logs"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@commitlint/types": "21.2.3",
    "@playwright/test": "1.65.0",
    "@tailwindcss/cli": "4.3.5",
    "@types/node": "24.19.2",
    "@zubatto-quiz/protocol": "workspace:*",
    "changelogen": "0.6.2",
    "consola": "3.4.2",
    "husky": "9.1.7",
    "oxfmt": "0.78.0",
    "oxlint": "1.93.0",
    "tailwindcss": "4.3.5",
    "typescript": "6.0.3",
    "vitest": "5.1.0"
  }
}
