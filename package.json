{
  "name": "zubatto-quiz",
  "private": true,
  "type": "module",
  "scripts": {
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "tsc": "tsc --noEmit && pnpm -r --if-present run tsc",
    "prepare": "husky",
    "mock:build": "tailwindcss -i docs/design/mock/mock.css -o docs/design/mock/dist/mock.css",
    "mock:watch": "tailwindcss -i docs/design/mock/mock.css -o docs/design/mock/dist/mock.css --watch",
    "lint": "oxlint --deny-warnings",
    "test": "vitest run",
    "e2e": "playwright test"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@commitlint/types": "^21.2.3",
    "@playwright/test": "1.63.0",
    "@tailwindcss/cli": "4.3.3",
    "@types/node": "^24.13.6",
    "consola": "^3.4.2",
    "husky": "^9.1.7",
    "oxfmt": "^0.68.0",
    "oxlint": "1.87.0",
    "tailwindcss": "4.3.3",
    "typescript": "^6.0.3",
    "vitest": "4.1.11"
  }
}
