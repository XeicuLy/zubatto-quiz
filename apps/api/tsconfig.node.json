{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // 設定のファイル・test/bundle/・scripts/ のコマンドの入口は node の上で動くので、Workers の型ではなく node の型を読む
    "types": ["node"]
  },
  "include": [
    "vitest.config.ts",
    "vitest.bundle.config.ts",
    "drizzle.config.ts",
