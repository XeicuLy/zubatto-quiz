{
  "$schema": "node_modules/wrangler/config-schema.json",
  // API の Worker（Hono・部屋の DO・Better Auth）。ブラウザからは画面の Worker の /api/* を通して呼ぶ（ADR 0006）
  "name": "zubakui-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  // Better Auth は node:async_hooks の AsyncLocalStorage を使う
  "compatibility_flags": ["nodejs_compat"],
  // 値は wrangler secret put（本番）と .dev.vars（ローカル）で入れる。ここに名前を書くと、wrangler types が .dev.vars がなくても同じ型を作る。
  // 値のない名前があると wrangler deploy が失敗する
  // BETTER_AUTH_URL は Better Auth の baseURL で、ブラウザから見える画面の Worker の URL にする（ADR 0006）。
  // 秘密の値ではないが、vars に書くとデプロイのたびにその値に戻り、本番の値を入れ忘れても localhost のまま動いてしまうので、ここに入れる。
  // https で始まるかで、Cookie の Secure と名前の __Secure- が決まる（ADR 0003）
  "secrets": { "required": ["BETTER_AUTH_URL", "BETTER_AUTH_SECRET", "GITHUB_CLIENT_ID", "GITHUB_CLIENT_SECRET"] },
  // 画面の Worker の Service binding からだけ呼ぶ。*.workers.dev とプレビューの URL を出さない（ADR 0006）
  "workers_dev": false,
  "preview_urls": false,
  "durable_objects": {
    "bindings": [{ "name": "ROOM", "class_name": "RoomDurableObject" }],
  },
  // 部屋の DO は SQLite を使う（ADR 0001）。一度デプロイしたタグは書き換えず、変えるときは新しいタグを足す
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["RoomDurableObject"] }],
  // database_id は書かない。デプロイと D1 のコマンドは名前で D1 を探す。database_name は変えない（ADR 0005）
  // migrations_dir は drizzle-kit の出力先（drizzle.config.ts の out）と同じ
  "d1_databases": [{ "binding": "DB", "database_name": "zubakui", "migrations_dir": "migrations" }],
  // O1: エラーのログを Workers Logs に残す。Traces は上限を分け合うので使わない（ADR 0005）
  "observability": {
    "enabled": true,
    // GitHub のログインから戻る URL の code・state を残さない
    "redact_query_string": true,
    "logs": { "invocation_logs": true, "head_sampling_rate": 1 },
  },
  // E2E（Playwright）だけで使う環境。本番は先頭の設定（wrangler deploy --env=""）でデプロイする（ADR 0003）
  // main をテスト専用の入口に替え、ホストのセッションを作る経路を足す。本番の入口（src/index.ts）からは import されない。
  // Worker の名前は zubakui-api-e2e になり、本番の画面の Worker とはつながらない。誤って --env e2e でデプロイしても、
  // この名前の Worker には秘密の値がないので、secrets.required に止められる
  // durable_objects・d1_databases・secrets は env に引き継がれないので、同じものを書く
  "env": {
    "e2e": {
      "main": "test/e2e-entry.ts",
      "secrets": { "required": ["BETTER_AUTH_URL", "BETTER_AUTH_SECRET", "GITHUB_CLIENT_ID", "GITHUB_CLIENT_SECRET"] },
      "durable_objects": { "bindings": [{ "name": "ROOM", "class_name": "RoomDurableObject" }] },
      "d1_databases": [{ "binding": "DB", "database_name": "zubakui", "migrations_dir": "migrations" }],
    },
  },
}
