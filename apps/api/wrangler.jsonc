{
  "$schema": "node_modules/wrangler/config-schema.json",
  // API の Worker（Hono・部屋の DO・Better Auth）。ブラウザからは画面の Worker の /api/* を通して呼ぶ（ADR 0006）
  "name": "zubakui-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  // Better Auth は node:async_hooks の AsyncLocalStorage を使う
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    // Better Auth の baseURL。ブラウザから見える画面の Worker の URL にする（ADR 0006）。ここはローカル（vite dev）とテストの値で、本番の値はデプロイのときに上書きする
    // https で始まるかで、Cookie の Secure と名前の __Secure- が決まる（ADR 0003）
    "BETTER_AUTH_URL": "http://localhost:5173",
  },
  // 値は wrangler secret put（本番）と .dev.vars（ローカル）で入れる。ここに名前を書くと、wrangler types が .dev.vars がなくても同じ型を作る
  "secrets": { "required": ["BETTER_AUTH_SECRET", "GITHUB_CLIENT_ID", "GITHUB_CLIENT_SECRET"] },
  // 画面の Worker の Service binding からだけ呼ぶ。*.workers.dev とプレビューの URL を出さない（ADR 0006）
  "workers_dev": false,
  "preview_urls": false,
  "durable_objects": {
    "bindings": [{ "name": "ROOM", "class_name": "RoomDurableObject" }],
  },
  // 部屋の DO は SQLite を使う（ADR 0001）。一度デプロイしたタグは書き換えず、変えるときは新しいタグを足す
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["RoomDurableObject"] }],
  // database_id は書かない。デプロイと D1 のコマンドは名前で D1 を探す。database_name は変えない（ADR 0005）
  // migrations_dir は drizzle-kit の出力先（drizzle.config.ts の out）と同じ
  "d1_databases": [{ "binding": "DB", "database_name": "zubakui", "migrations_dir": "migrations" }],
  // O1: エラーのログを Workers Logs に残す。Traces は上限を分け合うので使わない（ADR 0005）
  "observability": {
    "enabled": true,
    // GitHub のログインから戻る URL の code・state を残さない
    "redact_query_string": true,
    "logs": { "invocation_logs": true, "head_sampling_rate": 1 },
  },
}
