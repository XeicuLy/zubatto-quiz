{
  "name": "@zubatto-quiz/api",
  "private": true,
  "type": "module",
  "scripts": {
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply DB --local --persist-to ../web/.wrangler/state",
    "db:migrate:e2e": "wrangler d1 migrations apply DB --local --env e2e --persist-to ../web/.wrangler/e2e",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote --env=\"\"",
    "deploy": "wrangler deploy --env=\"\"",
    "dev": "wrangler dev",
    "tsc": "wrangler types --check && tsc -p tsconfig.json && tsc -p tsconfig.node.json",
    "types": "wrangler types",
    "logs": "wrangler tail --env=\"\" --format json"
  },
  "dependencies": {
    "@hono/zod-validator": "0.9.1",
    "@zubatto-quiz/protocol": "workspace:*",
    "@zubatto-quiz/scoring": "workspace:*",
    "better-auth": "1.7.19",
    "drizzle-orm": "0.45.4",
    "hono": "4.13.17",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.7.0",
    "@hono/swagger-ui": "0.6.2",
    "drizzle-kit": "0.31.11",
    "vitest": "5.1.0",
    "wrangler": "4.160.0"
  }
}
