{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // Workers の型は worker-configuration.d.ts（wrangler types で作る）から読む。node の型を混ぜると Request などがぶつかる
    // テストは cloudflare:test の型を使う。本番のコードからの import は oxlint で止める
    "types": ["@cloudflare/vitest-plugin/types"],
    // @/ はこのアプリの src/（ADR 0007）。vitest と apps/web の Vite は resolve.tsconfigPaths で、wrangler は esbuild がここを読む
    "paths": { "@/*": ["./src/*"] }
  },
  "include": ["src/**/*.ts", "test/**/*.ts", "worker-configuration.d.ts"],
  // node の上で走るテスト。tsconfig.node.json で確かめる
  "exclude": ["test/bundle"]
}
