{
  "name": "@zubatto-quiz/web",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "deploy": "vite build && wrangler deploy",
    "preview": "vite preview",
    "storybook": "storybook dev -p 6006",
    "storybook:build": "storybook build",
    "e2e:serve": "rm -rf .wrangler/e2e && CLOUDFLARE_ENV=e2e vite build --mode e2e && pnpm --filter @zubatto-quiz/api run db:migrate:e2e && vite preview --mode e2e --port 4173 --strictPort",
    "tsc": "wrangler types --check && tsc -p tsconfig.app.json && tsc -p tsconfig.worker.json && tsc -p tsconfig.node.json",
    "types": "wrangler types",
    "logs": "wrangler tail --env=\"\" --format json"
  },
  "dependencies": {
    "@base-ui/react": "1.9.0",
    "@fontsource-variable/m-plus-1": "5.3.1",
    "@fontsource/dela-gothic-one": "5.3.0",
    "@tanstack/react-query": "5.107.1",
    "@tanstack/react-router": "1.170.46",
    "@zubatto-quiz/protocol": "workspace:*",
    "@zubatto-quiz/scoring": "workspace:*",
    "better-auth": "1.7.19",
    "class-variance-authority": "0.7.1",
    "cn": "0.5.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "uqr": "0.1.3",
    "zustand": "5.1.0"
  },
  "devDependencies": {
    "@babel/core": "7.29.13",
    "@cloudflare/vite-plugin": "1.68.0",
    "@rolldown/plugin-babel": "0.3.1",
    "@storybook/addon-docs": "10.6.6",
    "@storybook/react-vite": "10.6.6",
    "@tailwindcss/node": "4.3.5",
    "@tailwindcss/vite": "4.3.5",
    "@tanstack/router-plugin": "1.169.0",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/babel__core": "7.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "babel-plugin-react-compiler": "1.0.0",
    "jsdom": "30.1.3",
    "shadcn": "4.23.0",
    "storybook": "10.6.7",
    "tailwindcss": "4.3.5",
    "vite": "8.3.7",
    "vitest": "5.1.0",
    "wrangler": "4.160.0"
  }
