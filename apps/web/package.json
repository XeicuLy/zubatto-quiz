{
  "name": "@zubatto-quiz/web",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "deploy": "vite build && wrangler deploy",
    "preview": "vite preview",
    "e2e:serve": "rm -rf .wrangler/e2e && CLOUDFLARE_ENV=e2e vite build --mode e2e && pnpm --filter @zubatto-quiz/api run db:migrate:e2e && vite preview --mode e2e --port 4173 --strictPort",
    "tsc": "wrangler types --check && tsc -p tsconfig.app.json && tsc -p tsconfig.worker.json && tsc -p tsconfig.node.json",
    "types": "wrangler types",
    "logs": "wrangler tail --env=\"\" --format json"
  },
  "dependencies": {
    "@base-ui/react": "1.9.0",
    "@fontsource-variable/m-plus-1": "5.3.0",
    "@fontsource/dela-gothic-one": "5.3.0",
    "@tanstack/react-query": "5.104.1",
    "@tanstack/react-router": "1.170.42",
    "@zubatto-quiz/protocol": "workspace:*",
    "@zubatto-quiz/scoring": "workspace:*",
    "better-auth": "1.7.7",
    "class-variance-authority": "0.7.1",
    "cn": "0.5.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "uqr": "0.1.3",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.63.1",
    "@tailwindcss/node": "4.3.3",
    "@tailwindcss/vite": "4.3.3",
    "@tanstack/router-plugin": "1.168.43",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "jsdom": "30.1.2",
    "shadcn": "4.22.1",
    "tailwindcss": "4.3.3",
    "vite": "8.3.4",
    "vitest": "4.1.11",
    "wrangler": "4.149.0"
  }
}
