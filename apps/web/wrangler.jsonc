{
  "$schema": "node_modules/wrangler/config-schema.json",
  // 画面の Worker。SPA を静的アセットで配り、/api/* だけを API の Worker へ転送する（ADR 0006）
  "name": "zubakui-web",
  "main": "src/server.ts",
  "compatibility_date": "2026-10-01",
  "assets": {
    // directory は書かない。Cloudflare の Vite プラグインが、ビルドした画面の出力先を入れる
    // 見つからない経路には /index.html を返し、画面の経路は TanStack Router が決める
    "not_found_handling": "single-page-application",
    // /api/* だけが Worker のコードを通る。ほかは静的アセットが返すので、public/_headers の CSP が付く
    "run_worker_first": ["/api/*"],
  },
  // API の Worker への転送。ブラウザからは同じオリジンに見えるので、CORS は要らない（ADR 0006）
  "services": [{ "binding": "API", "service": "zubakui-api" }],
  "observability": {
    "enabled": true,
    // GitHub のログインから戻る URL の code・state を残さない
    "redact_query_string": true,
    "logs": { "invocation_logs": true, "head_sampling_rate": 1 },
  },
  // E2E（Playwright）だけで使う環境。転送先を、テスト専用の入口を持つ API の Worker（apps/api の env.e2e）に替える。
  // services は env に引き継がれないので、ここに書く
  "env": {
    "e2e": {
      "services": [{ "binding": "API", "service": "zubakui-api-e2e" }],
    },
  },
}
