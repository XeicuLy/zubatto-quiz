{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // vite.config.ts・vitest.config.ts と、ファイルを読むテスト（test/*.test.ts）は node の上で動く
    "types": ["node"],
    // test/*.test.ts が src を @/ で読む（ADR 0007）。tsconfig.app.json と同じにする
    "paths": { "@/*": ["./src/*"] }
  },
  "include": ["vite.config.ts", "vitest.config.ts", "test/**/*.test.ts"]
}
