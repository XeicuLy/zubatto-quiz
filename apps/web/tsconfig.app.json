{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // 画面のコードはブラウザで動く
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "types": ["vite/client"],
    // @/ はこのアプリの src/（ADR 0007）。tsc のほか、Vite と vitest も resolve.tsconfigPaths でここを読む
    // （tsconfig.json の references から、そのファイルを include する tsconfig を探す）。tsconfig.json・tsconfig.node.json と同じにする
    "paths": { "@/*": ["./src/*"] }
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "test/setup.ts",
    "test/fake-room-server.ts",
    "test/fake-api.ts",
    "test/fake-sound.ts",
    "test/live-region.ts"
  ],
  // Worker の入口は tsconfig.worker.json で確かめる
  "exclude": ["src/server.ts", "src/server.test.ts"]
}
