{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // 画面のコードはブラウザで動く
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "types": ["vite/client"]
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", "test/setup.ts", "test/fake-room-server.ts", "test/fake-api.ts"],
  // Worker の入口は tsconfig.worker.json で確かめる
  "exclude": ["src/server.ts", "src/server.test.ts"]
}
