                  "minimum": 1,
                  "maximum": 9007199254740991
                },
                "phase": {
                  "type": "string",
                  "enum": ["lobby", "question", "accepting", "revealed", "fastest", "standings", "final"]
                },
                "questionIndex": {
                  "anyOf": [
                    {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 99
                    },
                    {
