{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ズバクイの WebSocket のメッセージ",
  "$defs": {
    "ClientMessage": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "join"
            },
            "name": {
              "type": "string",
              "minLength": 1,
              "pattern": "^(?:[^\\p{Cc}\\p{Cf}]|\\u200D)*$",
              "maxLength": 32,
              "description": "前後の空白を除いてから、長さ（コードポイント）と制御文字を確かめる"
            },
            "token": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]{42}[AEIMQUYcgkosw048]$"
            }
          },
          "required": ["type", "name", "token"]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "resume"
            },
            "token": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]{42}[AEIMQUYcgkosw048]$"
            }
          },
          "required": ["type", "token"]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "answer"
            },
            "questionId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64
            },
            "choiceIndex": {
              "type": "integer",
              "minimum": 0,
              "maximum": 3
            },
            "elapsedMs": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            }
          },
          "required": ["type", "questionId", "choiceIndex", "elapsedMs"]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "showQuestion"
            },
            "questionIndex": {
              "type": "integer",
              "minimum": 0,
              "maximum": 99
            }
          },
          "required": ["type", "questionIndex"]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "startAnswering"
            },
            "questionIndex": {
              "type": "integer",
              "minimum": 0,
              "maximum": 99
            }
          },
          "required": ["type", "questionIndex"]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "closeAnswering"
            },
            "questionIndex": {
              "type": "integer",
              "minimum": 0,
              "maximum": 99
            }
          },
          "required": ["type", "questionIndex"]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "revealFastest"
            },
            "questionIndex": {
              "type": "integer",
              "minimum": 0,
              "maximum": 99
            }
          },
          "required": ["type", "questionIndex"]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "showStandings"
            },
            "questionIndex": {
              "type": "integer",
              "minimum": 0,
              "maximum": 99
            }
          },
          "required": ["type", "questionIndex"]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "retryQuestion"
            },
            "questionIndex": {
              "type": "integer",
              "minimum": 0,
              "maximum": 99
            }
          },
          "required": ["type", "questionIndex"]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "showFinalRanking"
            }
          },
          "required": ["type"]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "endRoom"
            }
          },
          "required": ["type"]
        }
      ]
    },
    "ServerMessage": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "joined"
            },
            "participantId": {
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
            },
            "room": {
              "type": "object",
              "properties": {
                "title": {
                  "type": "string"
                },
                "questionCount": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 9007199254740991
                },
                "phase": {
                  "type": "string",
                  "enum": ["lobby", "question", "accepting", "revealed", "fastest", "standings", "final"]
                },
                "questionIndex": {
                  "anyOf": [
                    {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 99
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              },
              "required": ["title", "questionCount", "phase", "questionIndex"],
              "additionalProperties": false
            }
          },
          "required": ["type", "participantId", "room"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "resumed"
            },
            "participantId": {
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
            },
            "name": {
              "type": "string"
            },
            "score": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "room": {
              "type": "object",
              "properties": {
                "title": {
                  "type": "string"
                },
                "questionCount": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 9007199254740991
                },
                "phase": {
                  "type": "string",
                  "enum": ["lobby", "question", "accepting", "revealed", "fastest", "standings", "final"]
                },
                "questionIndex": {
                  "anyOf": [
                    {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 99
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              },
              "required": ["title", "questionCount", "phase", "questionIndex"],
              "additionalProperties": false
            }
          },
          "required": ["type", "participantId", "name", "score", "room"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "hostReady"
