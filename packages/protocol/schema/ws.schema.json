              "maximum": 9007199254740991
            },
            "participantCount": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            }
          },
          "required": ["type", "questionId", "correctIndex", "choiceCounts", "answeredCount", "participantCount"],
          "additionalProperties": false
