            "questionId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64
            },
            "questionIndex": {
              "type": "integer",
              "minimum": 0,
              "maximum": 99
            },
            "questionCount": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            },
            "text": {
              "type": "string"
            },
            "limitMs": {
              "type": "integer",
              "minimum": 5000,
              "maximum": 60000,
              "multipleOf": 1000
