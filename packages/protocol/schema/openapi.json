{
  "openapi": "3.1.0",
  "info": {
    "title": "ズバクイの HTTP API",
    "version": "1.0.0",
    "description": "ホストだけが使う HTTP API（S1）。部屋の進行は WebSocket で、その仕様は ws.schema.json にある。\n\nJSON Schema に出ない条件は、packages/protocol の zod のコードも合わせて読む。\n- 文字列は前後の空白を取り除いてから長さを数え、取り除いた値を保存する\n- 正解の番号は選択肢の数より小さい（Question の description にも書く）"
  },
  "servers": [
    {
      "url": "/",
      "description": "画面と同じオリジン"
    }
  ],
  "security": [
    {
      "hostSession": []
    }
  ],
  "paths": {
    "/api/question-sets": {
      "get": {
        "operationId": "listQuestionSets",
        "summary": "自分の問題セットの一覧を、更新の新しい順に返す",
        "responses": {
          "200": {
            "description": "一覧",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ListQuestionSetsResponse"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          }
        }
      },
      "post": {
        "operationId": "createQuestionSet",
        "summary": "問題セットを作る（F4）",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/QuestionSetInput"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "作った",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CreateQuestionSetResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          }
        }
      }
    },
    "/api/question-sets/{id}": {
      "parameters": [
        {
          "$ref": "#/components/parameters/QuestionSetId"
        }
      ],
      "get": {
        "operationId": "getQuestionSet",
        "summary": "正解を含む問題セットの全体を返す。ホストの編集画面だけが使う（S2）",
        "responses": {
          "200": {
            "description": "問題セット",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/QuestionSetDetail"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        }
      },
      "put": {
        "operationId": "updateQuestionSet",
        "summary": "問題セットを丸ごと置き換える（F7）",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/QuestionSetInput"
              }
            }
          }
        },
        "responses": {
          "204": {
            "description": "置き換えた"
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        }
      },
      "delete": {
        "operationId": "deleteQuestionSet",
        "summary": "問題セットを消す",
        "responses": {
          "204": {
            "description": "消した"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        }
      }
    },
    "/api/rooms": {
      "post": {
        "operationId": "createRoom",
        "summary": "自分の問題セットから部屋を作る（F1・ADR 0002）。セットは作ったときの中身が部屋に写る",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateRoomRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "作った",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CreateRoomResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "hostSession": {
        "type": "apiKey",
        "in": "cookie",
        "name": "__Secure-better-auth.session_token",
        "description": "GitHub でログインしたホストのセッションの Cookie（ADR 0003）。http の手元では __Secure- が付かない"
      }
    },
    "parameters": {
      "QuestionSetId": {
        "name": "id",
        "in": "path",
        "required": true,
        "description": "問題セットの ID（UUID）。UUID の形でない値も、他人のセットの ID と同じく 404 になる",
        "schema": {
          "type": "string"
        }
      }
    },
    "schemas": {
      "QuestionSetInput": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "questions": {
            "minItems": 1,
            "maxItems": 100,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "text": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 1000
                },
                "choices": {
                  "minItems": 2,
                  "maxItems": 4,
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 100
                  }
                },
                "correctIndex": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 3
                },
                "limitMs": {
                  "default": 10000,
                  "type": "integer",
                  "minimum": 5000,
                  "maximum": 60000,
                  "multipleOf": 1000
                }
              },
              "required": ["text", "choices", "correctIndex"],
              "description": "correctIndex は choices の数より小さい（JSON Schema では表せない条件）"
            }
          }
        },
        "required": ["title", "questions"]
      },
      "QuestionSetDetail": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "questions": {
            "minItems": 1,
            "maxItems": 100,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "text": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 1000
                },
                "choices": {
                  "minItems": 2,
                  "maxItems": 4,
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 100
                  }
                },
                "correctIndex": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 3
                },
                "limitMs": {
                  "default": 10000,
                  "type": "integer",
                  "minimum": 5000,
                  "maximum": 60000,
                  "multipleOf": 1000
                }
              },
              "required": ["text", "choices", "correctIndex", "limitMs"],
              "additionalProperties": false,
              "description": "correctIndex は choices の数より小さい（JSON Schema では表せない条件）"
            }
          },
          "id": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          }
        },
        "required": ["title", "questions", "id"],
        "additionalProperties": false
      },
      "ListQuestionSetsResponse": {
        "type": "object",
        "properties": {
          "questionSets": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "format": "uuid",
                  "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
                },
                "title": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 100
                },
                "questionCount": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "updatedAt": {
                  "type": "string",
                  "format": "date-time",
                  "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
                }
              },
              "required": ["id", "title", "questionCount", "updatedAt"],
              "additionalProperties": false
            }
          }
        },
        "required": ["questionSets"],
        "additionalProperties": false
      },
      "CreateQuestionSetResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          }
        },
        "required": ["id"],
        "additionalProperties": false
      },
      "CreateRoomRequest": {
        "type": "object",
        "properties": {
          "questionSetId": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          }
        },
        "required": ["questionSetId"]
      },
      "CreateRoomResponse": {
        "type": "object",
        "properties": {
          "roomId": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "joinUrl": {
            "type": "string",
            "format": "uri"
          }
        },
        "required": ["roomId", "joinUrl"],
        "additionalProperties": false
      },
      "HttpError": {
        "type": "object",
        "properties": {
          "error": {
            "type": "string",
            "enum": ["unauthorized", "invalid_request", "not_found"]
          }
        },
        "required": ["error"],
        "additionalProperties": false
      }
    },
    "responses": {
      "BadRequest": {
        "description": "本文が仕様に合わない。JSON として読めないときは、Hono がテキストで返す",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/HttpError"
            }
          },
          "text/plain": {
            "schema": {
              "type": "string"
            }
          }
        }
      },
      "Unauthorized": {
        "description": "ログインしていない、またはセッションが切れた",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/HttpError"
            }
          }
        }
      },
      "Forbidden": {
        "description": "csrf() が別のオリジンからのフォームの形の要求を断った。Hono がテキストで返す。本文が JSON の要求と、同じオリジンの要求では起きない",
        "content": {
          "text/plain": {
            "schema": {
              "type": "string"
            }
          }
        }
      },
      "NotFound": {
        "description": "ない、または他人のもの。どちらかは区別しない（S1）",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/HttpError"
            }
          }
        }
      }
    }
  }
}
