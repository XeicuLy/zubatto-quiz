{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  // wrangler types と TanStack Router のプラグインが作るファイルは見ない
  "ignorePatterns": ["**/worker-configuration.d.ts", "**/routeTree.gen.ts"],
  "plugins": ["typescript", "unicorn", "oxc", "react", "import", "vitest", "jsx-a11y"],
  "categories": {
    "correctness": "error"
  },
  "rules": {
    // role="status" の <p> を <output> に、<svg role="img"> を <img> にと勧めるが、どちらも当てはまらない。
    // <output> は計算や操作の結果を出す欄で、読み上げられるかが読み上げソフトによって違う。
    // インラインの SVG に名前を付けるには role="img" と aria-label を使う
    "jsx-a11y/prefer-tag-over-role": "off",
    "react/no-danger": "error",
    "react/no-danger-with-children": "error",
    // ADR 0004: 名前などの入力を HTML として解釈させない。文字として描画するには textContent や JSX の {} を使う
    "no-restricted-properties": [
      "error",
      { "property": "innerHTML", "message": "HTML として解釈される。textContent を使う。" },
      { "property": "outerHTML", "message": "HTML として解釈される。textContent を使う。" },
      { "property": "insertAdjacentHTML", "message": "HTML として解釈される。insertAdjacentText を使う。" },
      { "property": "setHTMLUnsafe", "message": "HTML として解釈される。textContent を使う。" },
      { "property": "createContextualFragment", "message": "HTML として解釈される。" },
      { "object": "document", "property": "write", "message": "HTML として解釈される。" },
      { "object": "document", "property": "writeln", "message": "HTML として解釈される。" }
    ],
    "no-restricted-imports": [
      "error",
      {
        "patterns": [
          {
            "group": ["**/test", "**/test/**", "**/*.test", "**/*.test.*", "**/*.spec", "**/*.spec.*"],
            "message": "本番のコードからテストのコードを import しない。"
          },
          {
            "group": ["@base-ui/*", "@base-ui/**"],
            "message": "画面は components/ui の部品を使う。Base UI を import するのは apps/web/src/components/ui の中だけ（ADR 0007）。"
          }
        ],
        "paths": [
          {
            "name": "cloudflare:test",
            "message": "テスト専用のモジュール。本番のコードでは cloudflare:workers を使う。"
          },
          {
            "name": "better-auth/plugins",
            "importNames": ["testUtils"],
            "message": "testUtils はテスト専用の auth インスタンス（apps/api/test/auth）にだけ入れる（ADR 0003）。"
          },
          {
            "name": "better-auth/test",
            "message": "Better Auth のテスト用のモジュール。本番のコードからは import しない（ADR 0003）。"
          }
        ]
      }
    ]
  },
  "overrides": [
    {
      // E2E（e2e/ と playwright.config.ts）もテストのコード。@playwright/test は名前が **/test に当たる
      "files": ["**/test/**", "**/*.test.*", "**/*.spec.*", "**/vitest.config.*", "e2e/**", "playwright.config.*"],
      "rules": {
        "no-restricted-imports": "off"
      }
    },
    {
      // UI 部品は Base UI を土台にする（ADR 0007）。上書きすると全体の設定が丸ごと置き換わるので、
      // @base-ui/* の禁止のほかは、全体の設定（patterns と paths）をそのまま書き写す。全体を直したら、ここも直す
      "files": ["apps/web/src/components/ui/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["**/test", "**/test/**", "**/*.test", "**/*.test.*", "**/*.spec", "**/*.spec.*"],
                "message": "本番のコードからテストのコードを import しない。"
              }
            ],
            "paths": [
              {
                "name": "cloudflare:test",
                "message": "テスト専用のモジュール。本番のコードでは cloudflare:workers を使う。"
              },
              {
                "name": "better-auth/plugins",
                "importNames": ["testUtils"],
                "message": "testUtils はテスト専用の auth インスタンス（apps/api/test/auth）にだけ入れる（ADR 0003）。"
              },
              {
                "name": "better-auth/test",
                "message": "Better Auth のテスト用のモジュール。本番のコードからは import しない（ADR 0003）。"
              }
            ]
          }
        ]
      }
    }
  ]
}
