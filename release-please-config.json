{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "release-type": "node",
  "include-component-in-tag": false,
  "pull-request-title-pattern": "chore: v${version} をリリースする",
  "pull-request-header": "このリリース PR をマージすると、タグと GitHub Release ができる。本番へのデプロイはしないので、マージのあとに deploy.yaml を動かす。",
  "bootstrap-sha": "70665dd2312410d09745cafc47e205e41d6b8a6e",
  "changelog-sections": [
    { "type": "feat", "section": "新機能" },
    { "type": "fix", "section": "修正" },
    { "type": "perf", "section": "性能" },
    { "type": "revert", "section": "取り消し", "hidden": true },
    { "type": "docs", "section": "ドキュメント", "hidden": true },
    { "type": "style", "section": "書式", "hidden": true },
    { "type": "refactor", "section": "リファクタリング", "hidden": true },
    { "type": "test", "section": "テスト", "hidden": true },
    { "type": "build", "section": "ビルド", "hidden": true },
    { "type": "ci", "section": "CI", "hidden": true },
    { "type": "chore", "section": "雑務", "hidden": true }
  ],
  "packages": {
    ".": {
      "release-as": "1.0.0"
    }
  }
}
